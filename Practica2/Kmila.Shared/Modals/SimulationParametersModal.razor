
<div class="input-group mb-3">
    
    <input type="number" class="form-control" aria-label="Text input with dropdown button" @bind="_time" min=0 max=1000/>
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Time scale: @_zone</button>
    <ul class="dropdown-menu">
        @foreach(var zone in _timeZones){
            <li><a class="dropdown-item" @onclick="() => SetZone(zone)">@zone</a></li>
        }
    </ul>
</div>
<div class="d-flex flex-row mb-3">
    <div class="flex-fill">
        <RangeInput TValue="int" @bind-Value="_time" Min="0" Max="1000" TickMarks="list" />
    </div>
    <Badge Color="@(_time > 750 ? BadgeColor.Danger :
            _time > 500 ? BadgeColor.Warning :
            _time > 250 ? BadgeColor.Success :
            BadgeColor.Info
        )"
        Class="ms-2" VisuallyHiddenText="amount1">@_time @_zone</Badge>
</div>

@code{
    private int _time = 0;
    private string _zone = "ns";
    private static List<string> _timeZones = new(){
        "ns", "ms", "s", "m", "h"
    };
    private void SetZone(string zone){
        _zone = zone;
        StateHasChanged();
    }
    private static IEnumerable<TickMark> list = new List<TickMark>
    {
        new(){ Label = "very cold!", Value = "0"},
        new(){ Label = "cool", Value = "250"},
        new(){ Label = "medium", Value = "500"},
        new(){ Label = "getting warm!", Value = "750"},
        new(){ Label = "hot!", Value = "1000"},
    };
}