<Sidebar2 @ref="_sidebar"
    ImageSrc="img/Logo.png"
    Href="/"
    IconName="IconName.BootstrapFill"
    Title="Kmila"
    BadgeText="v0.5.0"
    DataProvider="SidebarDataProvider" />
@code{
    private Sidebar2 _sidebar = new();
    private IEnumerable<NavItem>? _navItems;
    private List<Project> _projects = new();
    private async Task<Sidebar2DataProviderResult> SidebarDataProvider(Sidebar2DataProviderRequest request)
    {
        _projects = await Projects.GetListAsync();

        _navItems = GetNavItems();

        return await Task.FromResult(request.ApplyTo(_navItems));
    }
    private IEnumerable<NavItem> GetNavItems()
    {
        var items = new List<NavItem>
        {
            new () { Id = "1", Text = "Project Options"},
            new () { Id = "2", Href = "/projects", IconName = IconName.FolderPlus, Text = "Projects", IconColor = IconColor.Success, ParentId = "1" },
            new () { Id = "3", Href = "/projects/create", IconName = IconName.Plus, Text = "Create new project", IconColor = IconColor.Info, ParentId = "1" },
            new () { Id = "4", Text = "Projects Created", IconName = IconName.Folder2Open, ParentId = "1" }
        };
        int currentId = items.Count();
        foreach(var project in _projects){
            items.Add(new(){
                Id = $"{currentId++}",
                Text = project.Name,
                ParentId = "4",
                Href = $"/editor/{project.Id}",
                IconName = IconName.DeviceHdd,
                IconColor = IconColor.Warning
            });
        }
        return items;
    }

    private void ToggleSidebar() => _sidebar.ToggleSidebar();
}