@using Interpreter.Services
@using Parser.Models
<div class="card h-100">
    <div class="card-header">
        Entity
    </div>
    <div class="card-body">
        <h5 class="card-title">Name: @Entity.Name</h5>
        <p class="card-text">Ports:</p>
        <Grid TItem="Variable"
            Class="table table-hover table-bordered table-striped"
            Data="Entity.Ports"
            PageSize="10"
            Responsive="true">

            <GridColumns>
                <GridColumn TItem="Variable" HeaderText="Name" PropertyName="Name" SortKeySelector="item => item.Name">
                    @context.Name
                </GridColumn>
                <GridColumn TItem="Variable" HeaderText="Value" PropertyName="Value">
                    @context.Value
                </GridColumn>
                <GridColumn TItem="Variable" HeaderText="Type" PropertyName="Type" SortKeySelector="item => item.Type">
                    @context.Type
                </GridColumn>
            </GridColumns>

        </Grid>
    </div>
</div>
@code{
    [Parameter]
    public Entity Entity { get; set; }
}