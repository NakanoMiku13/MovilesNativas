@page "/"
@implements IDisposable
<h1>Hello, world!</h1>
<div class="row">
    <div class="col-12">
        <div class="card h-100 mb-3 my-3">
            <div class="card-header">Accelerometer</div>
            <div class="card-body">
                <p class="card-text">Acceleration: @_acceleration</p>
                <p class="card-text">X Acceleration: @_x</p>
                <p class="card-text">Y Acceleration: @_y</p>
                <p class="card-text">Z Acceleration: @_z</p>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card h-100 mb-3 my-3" @onclick=OnLocationRequested>
            <div class="card-header">Location</div>
            <div class="card-body">
                <p class="card-text">Latitude: @_location.Latitude</p>
                <p class="card-text">Longitude: @_location.Longitude</p>
                <p class="card-text">Altitude: @_location.Altitude</p>
                <p class="card-text">Accuracy: @_location.Accuracy</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-bg-@(_torchStatus ? "success" : "secondary") mb-3 my-3" @onclick="TorchStatusChanged">
            <div class="card-header">Torch</div>
            <div class="card-body">
                <h5 class="card-title">@(_torchStatus ? "On" : "Off") 
                    <Icon Name="@(_torchStatus ? IconName.LightbulbFill : IconName.LightbulbOffFill)"/>
                </h5>
            </div>
        </div>
    </div>
</div>

@code{
    private bool _torchStatus = false;
    private Models.Location _location = new();
    private double _acceleration, _x, _y, _z;
    protected override async Task OnInitializedAsync(){
        AccelerometerRepository.OnAccelerationChanged += OnAccelerationChanged;
        AccelerometerRepository.OnAccelerometerChanged += OnAccelerometerChanged;
        await Permissions.RequestAsync<Permissions.Camera>();
        await Permissions.RequestAsync<Permissions.LocationAlways>();
    }
    private async Task OnLocationRequested(){
        _location = await Repositories.Location.GetLocationAsync();
        StateHasChanged();
    }
    private async Task TorchStatusChanged(){
        try
        {
            if (_torchStatus)
                await Flashlight.TurnOnAsync();
            else
                await Flashlight.TurnOffAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message($"Flashlight error: {ex.Message}", "Error", ToastType.Danger));
        }
        StateHasChanged();
    }
    private void OnAccelerationChanged(double value){
        InvokeAsync(() => {
            _acceleration = value;
            StateHasChanged();
        });
    }
    private void OnAccelerometerChanged((double, double, double) vectors){
        InvokeAsync(() => {
            _x = vectors.Item1;
            _y = vectors.Item2;
            _z = vectors.Item3;
            StateHasChanged();
        });   
    }
    public void Dispose(){
        AccelerometerRepository.OnAccelerationChanged += OnAccelerationChanged;
        AccelerometerRepository.OnAccelerometerChanged += OnAccelerometerChanged;
    }

}